# Copy to .env.production, replace every placeholder, then protect it with chmod 600.
APP_ENV=production
APP_DEBUG=false
APP_DOMAIN=shop.example.com
TLS_EMAIL=admin@example.com

# Generate with: openssl rand -hex 32
APP_SECRET=CHANGE_ME_WITH_A_RANDOM_SECRET
JWT_SECRET=CHANGE_ME_WITH_A_RANDOM_SECRET

DB_HOST=db
DB_PORT=3306
DB_NAME=shopme
DB_USER=shopme_app
DB_PASS=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD

MYSQL_DATABASE=shopme
MYSQL_USER=shopme_app
MYSQL_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_WITH_A_DIFFERENT_LONG_RANDOM_PASSWORD
